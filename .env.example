# Copy to .env. Everything here is optional; these are the defaults.

# Port the web UI is served on (http://localhost:8080).
WEB_PORT=8080

# Job workers. Each runs simulations in parallel up to APOGEE_MAX_JOBS.
WORKER_REPLICAS=2
APOGEE_MAX_JOBS=4

# Field mode: lands on the go/no-go board, smaller Monte Carlo defaults,
# offline sources only. Changing it needs a rebuild of the web image.
FIELD_MODE=false

# Basemap tiles served by the `tiles` service (docker compose --profile full).
# MAP_PMTILES=/tiles/basemap.pmtiles

# Host directory of mission configs, mounted at /missions.
MISSIONS_DIR=./missions

# Recorded in every result's provenance. `make up` sets it from git.
GIT_SHA=dev

# Redis port on localhost, for running api/worker outside Docker.
REDIS_PORT=6379
